// 5. ERA5-LAND DAILY TEMPERATURE
// ============================================================================

var era5 = ee.ImageCollection('ECMWF/ERA5_LAND/DAILY_AGGR')
  .filterBounds(basin)
  .filterDate(OBS_START, OBS_END);

print('ERA5-Land image count:', era5.size());
print('ERA5-Land first image band names:', era5.first().bandNames());

var era5Daily = ee.FeatureCollection(
  era5.map(function(image) {
    image = ee.Image(image);

    var tmax = image.select('temperature_2m_max')
      .subtract(273.15)
      .rename('tasmax_c');

    var tmin = image.select('temperature_2m_min')
      .subtract(273.15)
      .rename('tasmin_c');

    var combined = tmax.addBands(tmin);

    var stats = combined.reduceRegion({
      reducer: ee.Reducer.mean(),
      geometry: basin,
      scale: SCALE_OBS,
      maxPixels: MAX_PIXELS,
      bestEffort: true,
      tileScale: TILE_SCALE
    });

    var date = image.date();

    return ee.Feature(null, {
      date: date.format('YYYY-MM-dd'),
      year: date.get('year'),
      month: date.get('month'),
      day: date.get('day'),
      doy: date.getRelative('day', 'year').add(1),
      dataset: 'ERA5_Land',
      tasmax_c: safeNumber(stats, 'tasmax_c'),
      tasmin_c: safeNumber(stats, 'tasmin_c')
    });
  })
).filter(
  ee.Filter.notNull([
    'tasmax_c',
    'tasmin_c'
  ])
);

