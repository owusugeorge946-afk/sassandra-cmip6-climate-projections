// ============================================================================
// 10. CMIP6 ENSEMBLE PERIOD MAP FUNCTIONS
// ============================================================================

function modelPeriodMean(model, scenario, startDate, endDate) {

  var collection = cmip6Raw
    .filter(ee.Filter.eq('model', model))
    .filter(ee.Filter.eq('scenario', scenario))
    .filterDate(startDate, endDate)
    .select(['pr', 'tasmax', 'tasmin'])
    .map(convertCMIPImage);

  var annualYears = ee.List.sequence(
    ee.Date(startDate).get('year'),
    ee.Date(endDate).advance(-1, 'day').get('year')
  );

  var annual = ee.ImageCollection.fromImages(
    annualYears.map(function(year) {
      year = ee.Number(year);

      var yearStart = ee.Date.fromYMD(year, 1, 1);
      var yearEnd = yearStart.advance(1, 'year');
      var yearCollection = collection.filterDate(yearStart, yearEnd);

      var precipitation = yearCollection
        .select('precipitation_mm_day')
        .sum()
        .rename('precipitation_mm_year');

      var tasmax = yearCollection
        .select('tasmax_c')
        .mean()
        .rename('tasmax_c');

      var tasmin = yearCollection
        .select('tasmin_c')
        .mean()
        .rename('tasmin_c');

      return precipitation
        .addBands(tasmax)
        .addBands(tasmin)
        .set('year', year)
        .set('system:time_start', yearStart.millis());
    })
  );

  return annual.mean()
    .set('model', model)
    .set('scenario', scenario)
    .set('start_date', startDate)
    .set('end_date', endDate);
}


function ensemblePeriodMean(scenario, startDate, endDate) {

  var images = MODELS.map(function(model) {
    return modelPeriodMean(
      model,
      scenario,
      startDate,
      endDate
    );
  });

  return ee.ImageCollection.fromImages(images)
    .median()
    .clip(basin);
}


function historicalEnsembleMean() {

  var images = MODELS.map(function(model) {
    return modelPeriodMean(
      model,
      'historical',
      BASELINE_START,
      BASELINE_END
    );
  });

  return ee.ImageCollection.fromImages(images)
    .median()
    .clip(basin);
}


// ============================================================================
// 11. EXPORT ENSEMBLE CLIMATE-CHANGE MAPS
// ============================================================================

var historicalEnsemble = historicalEnsembleMean();

var periods = [
  {
    label: 'Near_2021_2040',
    start: '2021-01-01',
    end: '2041-01-01'
  },
  {
    label: 'Mid_2041_2060',
    start: '2041-01-01',
    end: '2061-01-01'
  },
  {
    label: 'Late_2081_2100',
    start: '2081-01-01',
    end: '2101-01-01'
  }
];

SCENARIOS.forEach(function(scenario) {

  periods.forEach(function(period) {

    var futureEnsemble = ensemblePeriodMean(
      scenario,
      period.start,
      period.end
    );

    var precipitationChange = futureEnsemble
      .select('precipitation_mm_year')
      .subtract(
        historicalEnsemble.select('precipitation_mm_year')
      )
      .divide(
        historicalEnsemble.select('precipitation_mm_year')
      )
      .multiply(100)
      .rename('precipitation_change_percent');

    var tmaxChange = futureEnsemble
      .select('tasmax_c')
      .subtract(
        historicalEnsemble.select('tasmax_c')
      )
      .rename('tasmax_change_c');

    var tminChange = futureEnsemble
      .select('tasmin_c')
      .subtract(
        historicalEnsemble.select('tasmin_c')
      )
      .rename('tasmin_change_c');

    var changeImage = precipitationChange
      .addBands(tmaxChange)
      .addBands(tminChange)
      .clip(basin);

    var outputName =
      'SASAN_CMIP6_Ensemble_Change_' +
      scenario +
      '_' +
      period.label;

    Export.image.toDrive({
      image: changeImage,
      description: outputName,
      folder: DRIVE_FOLDER,
      fileNamePrefix: outputName,
      region: basin,
      scale: SCALE_CMIP,
      maxPixels: MAX_PIXELS,
      fileFormat: 'GeoTIFF'
    });

  });
});


