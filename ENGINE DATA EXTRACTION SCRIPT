// ============================================================================
// 3. HELPER FUNCTIONS
// ============================================================================

function safeNumber(dictionary, propertyName) {
  dictionary = ee.Dictionary(dictionary);

  return ee.Algorithms.If(
    dictionary.contains(propertyName),
    dictionary.get(propertyName),
    null
  );
}


function addDateProperties(feature, date) {
  date = ee.Date(date);

  return ee.Feature(feature).set({
    date: date.format('YYYY-MM-dd'),
    year: date.get('year'),
    month: date.get('month'),
    day: date.get('day'),
    doy: date.getRelative('day', 'year').add(1)
  });
}


function imageMeanFeature(image, bandName, scale) {
  image = ee.Image(image);
  var date = image.date();

  var stats = image.select(bandName).reduceRegion({
    reducer: ee.Reducer.mean(),
    geometry: basin,
    scale: scale,
    maxPixels: MAX_PIXELS,
    bestEffort: true,
    tileScale: TILE_SCALE
  });

  var feature = ee.Feature(null, {});
  feature = addDateProperties(feature, date);

  return feature.set(bandName, safeNumber(stats, bandName));
}


function convertCMIPImage(image) {
  image = ee.Image(image);

  var precipitation = image.select('pr')
    .multiply(86400)
    .rename('precipitation_mm_day');

  var tasmax = image.select('tasmax')
    .subtract(273.15)
    .rename('tasmax_c');

  var tasmin = image.select('tasmin')
    .subtract(273.15)
    .rename('tasmin_c');

  return ee.Image.cat([
      precipitation,
      tasmax,
      tasmin
    ])
    .copyProperties(image, image.propertyNames());
}


function cmipDailyFeature(image, model, scenario) {
  image = ee.Image(image);
  var date = image.date();

  var stats = image.reduceRegion({
    reducer: ee.Reducer.mean(),
    geometry: basin,
    scale: SCALE_CMIP,
    maxPixels: MAX_PIXELS,
    bestEffort: true,
    tileScale: TILE_SCALE
  });

  var feature = ee.Feature(null, {});
  feature = addDateProperties(feature, date);

  return feature.set({
    model: model,
    scenario: scenario,
    precipitation_mm_day:
      safeNumber(stats, 'precipitation_mm_day'),
    tasmax_c:
      safeNumber(stats, 'tasmax_c'),
    tasmin_c:
      safeNumber(stats, 'tasmin_c')
  });
}


function mergeFeatureCollections(collectionList) {
  return ee.FeatureCollection(
    ee.List(collectionList).iterate(
      function(collection, accumulator) {
        return ee.FeatureCollection(accumulator)
          .merge(ee.FeatureCollection(collection));
      },
      ee.FeatureCollection([])
    )
  );
}


